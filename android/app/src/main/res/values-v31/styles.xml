<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- On Android 12+ (API 31+), suppress the system splash icon and match the window background
         to the Flutter SplashScreen widget background (#0E1D38) so only the Flutter splash is seen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
